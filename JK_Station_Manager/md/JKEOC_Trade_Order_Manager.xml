<?xml version="1.0" encoding="utf-8" ?>
<mdscript name="JKEOC_Trade_Order_Manager" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <cues>
    <cue name="JKEOC_B73_Init" instantiate="true" namespace="this"><conditions><event_game_loaded /></conditions><delay exact="40s" /><actions>
      <do_if value="not global.$JKEOC_B73TradeMode?"><set_value name="global.$JKEOC_B73TradeMode" exact="'ADVISOR'" /></do_if>
      <do_if value="not global.$JKEOC_B73Offers?"><set_value name="global.$JKEOC_B73Offers" exact="[]" /></do_if>
      <debug_text text="'[JKEOC][B73][READY] mode=%1 offers=%2'.[global.$JKEOC_B73TradeMode, global.$JKEOC_B73Offers.count]" filter="general" />
    </actions></cue>
    <cue name="JKEOC_B73_Scheduler" instantiate="true" namespace="this" checktime="player.age + 5min" checkinterval="5min"><conditions><check_value value="global.$JKEOC_B73TradeMode? and global.$JKEOC_B73TradeMode == 'MANAGED'" /></conditions><actions><signal_cue_instantly cue="JKEOC_B73_Reconcile" /></actions></cue>

    <cue name="JKEOC_B73_Menu" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B73_Menu" /></conditions><actions>
      <add_player_choice_sub text="'INFO: MODE %1 | EOC OFFERS %2'.[global.$JKEOC_B73TradeMode, global.$JKEOC_B73Offers.count]" position="top_left" section="JKEOC_B73_Menu" />
      <add_player_choice_sub text="'ADVISOR MODE - INSTRUCTIONS ONLY'" position="left" section="JKEOC_B73_AdvisorConfirm" />
      <add_player_choice_sub text="'MANAGED MODE - EOC BUY/SELL ORDERS'" position="bottom_left" section="JKEOC_B73_ManagedConfirm" />
      <add_player_choice_sub text="'ACTION: REVIEW ORDERS NOW'" position="top_right" section="JKEOC_B73_Run" />
      <add_player_choice_sub text="'REPORT: TRADE ORDER STATUS'" position="right" section="JKEOC_B73_Report" />
      <add_player_choice_sub text="'BACK'" position="bottom_right" section="JKEOC_B72_OperationsHub" />
    </actions></cue>
    <cue name="JKEOC_B73_ManagedConfirm" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B73_ManagedConfirm" /></conditions><actions>
      <add_player_choice_sub text="'INFO: EOC MAY CREATE EVIDENCE-SUPPORTED BUY AND SELL OFFERS'" position="top_left" section="JKEOC_B73_ManagedConfirm" />
      <add_player_choice_sub text="'INFO: SHIPS REMAIN PLAYER CONTROLLED'" position="left" section="JKEOC_B73_ManagedConfirm" />
      <add_player_choice_sub text="'AUTHORIZE MANAGED TRADE ORDERS'" position="right" section="JKEOC_B73_Enable" /><add_player_choice_sub text="'BACK - NO CHANGE'" position="bottom_right" section="JKEOC_B73_Menu" />
    </actions></cue>
    <cue name="JKEOC_B73_Enable" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B73_Enable" /></conditions><actions><signal_cue_instantly cue="JKEOC_B73_ApplyManaged" /><add_player_choice_sub text="'ENABLED - RETURN'" position="bottom_right" section="JKEOC_B73_Menu" /></actions></cue>
    <cue name="JKEOC_B73_ApplyManaged" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><actions>
      <set_value name="global.$JKEOC_B73TradeMode" exact="'MANAGED'" /><debug_text text="'[JKEOC][B83F][MODE_APPLY] MANAGED player_authorized=1'" filter="general" /><show_notification text="'ACTION: EOC Managed Trade Orders enabled.'" timeout="10s" /><signal_cue_instantly cue="JKEOC_B73_Reconcile" />
    </actions></cue>
    <cue name="JKEOC_B73_AdvisorConfirm" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B73_AdvisorConfirm" /></conditions><actions>
      <add_player_choice_sub text="'INFO: REMOVE ONLY EOC-CREATED OFFERS; KEEP TIPS INSTRUCTIONS'" position="top_left" section="JKEOC_B73_AdvisorConfirm" /><add_player_choice_sub text="'DISABLE MANAGED ORDERS'" position="right" section="JKEOC_B73_Disable" /><add_player_choice_sub text="'BACK - NO CHANGE'" position="bottom_right" section="JKEOC_B73_Menu" />
    </actions></cue>
    <cue name="JKEOC_B73_Disable" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B73_Disable" /></conditions><actions><signal_cue_instantly cue="JKEOC_B73_ApplyAdvisor" /><add_player_choice_sub text="'RETURN'" position="bottom_right" section="JKEOC_B73_Menu" /></actions></cue>
    <cue name="JKEOC_B73_ApplyAdvisor" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><actions>
      <set_value name="global.$JKEOC_B73TradeMode" exact="'ADVISOR'" /><set_value name="$fail" exact="0" /><do_for_each name="$o" in="global.$JKEOC_B73Offers"><do_if value="$o.$offer? and $o.$offer.exists and $o.$station.exists"><remove_trade_offer object="$o.$station" tradeoffer="$o.$offer" /></do_if></do_for_each><do_for_each name="$o" in="global.$JKEOC_B73Offers"><do_if value="$o.$offer? and $o.$offer.exists"><set_value name="$fail" exact="$fail + 1" /></do_if></do_for_each>
      <do_if value="$fail == 0"><set_value name="global.$JKEOC_B73Offers" exact="[]" /><show_notification text="'ACTION: Advisor Mode active. All EOC-created offers removed.'" timeout="10s" /></do_if><do_else><show_notification text="'WARNING: %1 EOC offer(s) remain. Do not save; report debug log.'.[$fail]" timeout="15s" /></do_else><debug_text text="'[JKEOC][B83F][ROLLBACK] failed=%1'.[$fail]" filter="general" />
    </actions></cue>
    <cue name="JKEOC_B73_Run" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B73_Run" /></conditions><actions><signal_cue_instantly cue="md.JKEOC_Operational_Remediation.JKEOC_B70_Analyze" /><signal_cue_instantly cue="JKEOC_B73_Reconcile" /><add_player_choice_sub text="'REVIEW COMPLETE - RETURN'" position="bottom_right" section="JKEOC_B73_Menu" /></actions></cue>

    <cue name="JKEOC_B73_Reconcile" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><delay exact="3s" /><actions>
      <set_value name="$created" exact="0" /><set_value name="$blocked" exact="0" />
      <do_if value="global.$JKEOC_B73TradeMode == 'MANAGED'"><do_for_each name="$r" in="global.$JKEOC_B70Remediations">
        <set_value name="$buy" exact="($r.$category == 'PRODUCTION SHORTAGE' or $r.$category == 'STALLED PRODUCTION' or $r.$category == 'WORKFORCE SUPPLY FAILURE' or $r.$category == 'WORKFORCE SUPPLY INTELLIGENCE') and ($r.$state == 'OPEN' or $r.$state == 'ESCALATED')" /><set_value name="$sell" exact="$r.$category == 'STORAGE PRESSURE' and ($r.$state == 'OPEN' or $r.$state == 'ESCALATED')" />
        <set_value name="$found" exact="false" /><do_for_each name="$o" in="global.$JKEOC_B73Offers"><do_if value="$o.$remediation == $r and $o.$offer? and $o.$offer.exists"><set_value name="$found" exact="true" /></do_if></do_for_each>
        <do_if value="($buy or $sell) and not $found and global.$JKEOC_B73Offers.count lt 64 and $r.$station.exists and $r.$station.owner == faction.player and $r.$subjectkey?">
          <remove_value name="$offer" /><remove_value name="$type" />
          <set_value name="$amount" exact="if $buy then $r.$lasttarget - $r.$lastamount else $r.$lastamount - $r.$lasttarget" />
          <do_if value="$amount gt 0 and $buy"><create_trade_offer name="$offer" object="$r.$station" buyer="$r.$station" ware="$r.$subjectkey" amount="$amount" price="$r.$subjectkey.maxprice" playeronly="false" /><set_value name="$type" exact="'BUY'" /></do_if>
          <do_elseif value="$amount gt 0 and $sell"><create_trade_offer name="$offer" object="$r.$station" seller="$r.$station" ware="$r.$subjectkey" amount="$amount" price="$r.$subjectkey.minprice" playeronly="false" /><set_value name="$type" exact="'SELL'" /></do_elseif>
          <do_else><debug_text text="'[JKEOC][B77][OFFER_BLOCKED] remediation=%1 reason=NO_EVIDENCED_VOLUME current=%2 target=%3'.[$r.$identity, $r.$lastamount, $r.$lasttarget]" filter="general" /></do_else>
          <do_if value="$offer? and $offer.exists"><append_to_list name="global.$JKEOC_B73Offers" exact="table[$remediation=$r, $station=$r.$station, $stationname=$r.$stationname, $ware=$r.$subjectkey, $type=$type, $amount=$amount, $offer=$offer, $verified=false]" /><set_value name="$created" exact="$created + 1" /><debug_text text="'[JKEOC][B73][OFFER_CREATED] remediation=%1 type=%2 station=%3 ware=%4 amount=%5'.[$r.$identity, $type, $r.$stationname, $r.$subjectkey.name, $amount]" filter="general" /></do_if><do_else><set_value name="$blocked" exact="$blocked + 1" /></do_else>
        </do_if>
      </do_for_each><signal_cue_instantly cue="JKEOC_B73_Verify" /></do_if>
      <debug_text text="'[JKEOC][B73][RECONCILE] mode=%1 created=%2 blocked=%3 tracked=%4'.[global.$JKEOC_B73TradeMode, $created, $blocked, global.$JKEOC_B73Offers.count]" filter="general" />
    </actions></cue>
    <cue name="JKEOC_B73_Verify" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><delay exact="2s" /><actions><set_value name="$pass" exact="0" /><set_value name="$fail" exact="0" /><set_value name="$valid" exact="[]" /><do_for_each name="$o" in="global.$JKEOC_B73Offers"><set_value name="$ok" exact="$o.$offer? and $o.$offer.exists and $o.$offer.ware == $o.$ware and (($o.$type == 'BUY' and $o.$offer.isbuyoffer) or ($o.$type == 'SELL' and $o.$offer.isselloffer))" /><set_value name="$o.$verified" exact="$ok" /><do_if value="$ok"><append_to_list name="$valid" exact="$o" /><set_value name="$pass" exact="$pass + 1" /></do_if><do_else><set_value name="$fail" exact="$fail + 1" /><debug_text text="'[JKEOC][B78][OFFER_PRUNED] remediation=%1 station=%2 ware=%3 type=%4 reason=%5'.[if $o.$remediation? then $o.$remediation.$identity else 'UNAVAILABLE', $o.$stationname, if $o.$ware? then $o.$ware.name else 'UNAVAILABLE', $o.$type, if not $o.$offer? or not $o.$offer.exists then 'OFFER_MISSING' else if $o.$offer.ware != $o.$ware then 'WARE_MISMATCH' else 'TYPE_MISMATCH']" filter="general" /><do_if value="$o.$offer? and $o.$offer.exists and $o.$station.exists"><remove_trade_offer object="$o.$station" tradeoffer="$o.$offer" /></do_if></do_else></do_for_each><set_value name="global.$JKEOC_B73Offers" exact="$valid" /><debug_text text="'[JKEOC][B78][VERIFY] passed=%1 pruned=%2 retained=%3'.[$pass, $fail, $valid.count]" filter="general" /><do_if value="$fail gt 0"><show_notification text="'ACTION: %1 stale EOC trade offer record(s) removed; %2 valid offer(s) retained.'.[$fail, $pass]" timeout="12s" /></do_if><do_elseif value="$pass gt 0"><show_notification text="'ACTION: %1 EOC trade offer(s) verified.'.[$pass]" timeout="8s" /></do_elseif></actions></cue>
    <cue name="JKEOC_B73_Report" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B73_Report" /></conditions><actions><set_value name="$details" exact="''" /><set_value name="$verified" exact="0" /><do_for_each name="$o" in="global.$JKEOC_B73Offers"><set_value name="$details" exact="'%1\n%2 | %3 | %4 | amount %5 | verified %6'.[$details, $o.$stationname, $o.$type, $o.$ware.name, $o.$amount, $o.$verified]" /><do_if value="$o.$verified"><set_value name="$verified" exact="$verified + 1" /></do_if></do_for_each><set_value name="$reporttext" exact="'Mode: %1\nEOC-owned offers: %2\nVerified: %3\n\nAdvisor Mode gives instructions only. Managed Mode creates evidence-supported offers. Disabling removes only EOC-created offers. Ships remain player controlled.%4\n\nEND OF REPORT'.[global.$JKEOC_B73TradeMode, global.$JKEOC_B73Offers.count, $verified, $details]" /><write_to_logbook category="tips" title="'EOC Trade Order Status'" text="$reporttext" /><signal_cue_instantly cue="md.JKEOC_Settings_Interface.JKEOC_Settings_RecordReport" param="['TRADE ORDER STATUS', $reporttext]" /><show_notification text="'REPORT: Trade Order Status saved to Tips and available in the EOC Reports tab.'" timeout="8s" /><add_player_choice_sub text="'RETURN'" position="bottom_right" section="JKEOC_B73_Menu" /></actions></cue>
    <cue name="JKEOC_B160_RemoveMarketTest" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><actions>
      <set_value name="$retained" exact="[]" /><set_value name="$removed" exact="0" />
      <do_for_each name="$o" in="global.$JKEOC_B73Offers"><do_if value="$o.$markettest? and $o.$stationname == global.$JKEOC_B160RemoveStation and $o.$ware? and $o.$ware.name == global.$JKEOC_B160RemoveSubject and $o.$type == global.$JKEOC_B160RemoveType"><do_if value="$o.$offer? and $o.$offer.exists and $o.$station? and $o.$station.exists"><remove_trade_offer object="$o.$station" tradeoffer="$o.$offer" /></do_if><set_value name="$removed" exact="$removed + 1" /></do_if><do_else><append_to_list name="$retained" exact="$o" /></do_else></do_for_each>
      <set_value name="global.$JKEOC_B73Offers" exact="$retained" /><set_value name="$result" exact="if $removed gt 0 then 'EOC removed %1 matching test offer(s). Original station rules and non-EOC offers were untouched.'.[$removed] else 'No matching EOC market test was active. Nothing changed.'" />
      <raise_lua_event name="'JKEOC_SettingsMenu.action.name'" param="'market.test.remove'" /><raise_lua_event name="'JKEOC_SettingsMenu.action.result'" param="$result" /><raise_lua_event name="'JKEOC_SettingsMenu.action.time'" param="player.age" /><raise_lua_event name="'JKEOC_SettingsMenu.action.complete'" /><show_notification text="$result" timeout="10s" /><debug_text text="'[JKEOC][B162][MARKET_TEST_REMOVE] station=%1 ware=%2 type=%3 removed=%4'.[global.$JKEOC_B160RemoveStation, global.$JKEOC_B160RemoveSubject, global.$JKEOC_B160RemoveType, $removed]" filter="general" />
    </actions></cue>

    <cue name="JKEOC_B160_CreateMarketTest" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><actions>
      <set_value name="$case" exact="global.$JKEOC_B160TestCase" /><set_value name="$type" exact="global.$JKEOC_B160TestType" /><set_value name="$result" exact="'Market test cancelled: EOC could not resolve the selected station or ware. Nothing changed.'" />
      <do_if value="$case? and $case.$station? and $case.$station.exists and $case.$station.owner == faction.player and $case.$wareobject?">
        <set_value name="$duplicate" exact="false" /><do_for_each name="$o" in="global.$JKEOC_B73Offers"><do_if value="$o.$station == $case.$station and $o.$ware == $case.$wareobject and $o.$type == $type and $o.$offer? and $o.$offer.exists"><set_value name="$duplicate" exact="true" /></do_if></do_for_each>
        <do_if value="$duplicate"><set_value name="$result" exact="'No duplicate created. An EOC-owned %1 offer already exists for %2 at %3.'.[$type, $case.$ware, $case.$stationname]" /></do_if>
        <do_else>
          <set_value name="$amount" exact="if $type == 'BUY' then if $case.$immediateneed? and $case.$immediateneed gt 0 then $case.$immediateneed else if $case.$targetshortfall? and $case.$targetshortfall gt 0 then $case.$targetshortfall else 1 else if $case.$amount? and $case.$target? and $case.$amount gt $case.$target then $case.$amount - $case.$target else 1" />
          <do_if value="$amount gt 0 and $type == 'BUY'"><create_trade_offer name="$offer" object="$case.$station" buyer="$case.$station" ware="$case.$wareobject" amount="$amount" price="$case.$wareobject.maxprice" playeronly="false" /></do_if>
          <do_elseif value="$amount gt 0 and $type == 'SELL'"><create_trade_offer name="$offer" object="$case.$station" seller="$case.$station" ware="$case.$wareobject" amount="$amount" price="$case.$wareobject.minprice" playeronly="false" /></do_elseif>
          <do_if value="$offer? and $offer.exists"><append_to_list name="global.$JKEOC_B73Offers" exact="table[$remediation=null, $station=$case.$station, $stationname=$case.$stationname, $ware=$case.$wareobject, $type=$type, $amount=$amount, $offer=$offer, $verified=true, $markettest=true, $created=player.age, $baseline=if $case.$amount? then $case.$amount else 0]" /><set_value name="$result" exact="'EOC created one bounded NPC-enabled %1 test for %2 at %3 (amount %4). Your existing ware rule was not changed. Run Verify Result after a delivery cycle.'.[$type, $case.$ware, $case.$stationname, $amount]" /><debug_text text="'[JKEOC][B162][MARKET_TEST_CREATED] station=%1 ware=%2 type=%3 amount=%4 playeronly=false existing_rule=PRESERVED'.[$case.$stationname, $case.$ware, $type, $amount]" filter="general" /></do_if>
          <do_else><set_value name="$result" exact="'EOC could not create the bounded market test. No station policy or existing offer was changed.'" /><debug_text text="'[JKEOC][B162][MARKET_TEST_BLOCKED] station=%1 ware=%2 type=%3'.[$case.$stationname, $case.$ware, $type]" filter="error" /></do_else>
        </do_else>
      </do_if>
      <raise_lua_event name="'JKEOC_SettingsMenu.action.name'" param="'market.test'" /><raise_lua_event name="'JKEOC_SettingsMenu.action.result'" param="$result" /><raise_lua_event name="'JKEOC_SettingsMenu.action.time'" param="player.age" /><raise_lua_event name="'JKEOC_SettingsMenu.action.complete'" /><show_notification text="$result" timeout="14s" />
    </actions></cue>
  </cues>
</mdscript>
