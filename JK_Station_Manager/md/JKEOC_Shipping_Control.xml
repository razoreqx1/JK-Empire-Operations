<?xml version="1.0" encoding="utf-8" ?>
<mdscript name="JKEOC_Shipping_Control" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><cues>
  <cue name="JKEOC_B76_Init" instantiate="true" namespace="this"><conditions><event_game_loaded /></conditions><delay exact="45s" /><actions><do_if value="not global.$JKEOC_B76AssignmentMode?"><set_value name="global.$JKEOC_B76AssignmentMode" exact="'APPROVAL REQUIRED'" /></do_if><do_if value="not global.$JKEOC_B76EligibleShips?"><set_value name="global.$JKEOC_B76EligibleShips" exact="[]" /></do_if><set_value name="$eligible" exact="[]" /><do_for_each name="$ship" in="global.$JKEOC_B76EligibleShips"><do_if value="$ship.exists and $ship.owner == faction.player and $ship.isclass.ship and $ship.isoperational and ($ship.primarypurpose == purpose.trade or $ship.primarypurpose == purpose.mine) and not $ship.isunit and not $ship.isclass.ship_xs and not $ship.commander and not $ship.subordinates.count"><append_to_list name="$eligible" exact="$ship" /></do_if></do_for_each><set_value name="global.$JKEOC_B76EligibleShips" exact="$eligible" /><do_if value="global.$JKEOC_B74PendingShip? and (not global.$JKEOC_B74PendingShip.exists or not global.$JKEOC_B74PendingShip.isclass.ship or global.$JKEOC_B74PendingShip.isunit or global.$JKEOC_B74PendingShip.isclass.ship_xs or global.$JKEOC_B74PendingShip.commander or global.$JKEOC_B74PendingShip.subordinates.count)"><remove_value name="global.$JKEOC_B74PendingRemediation" /><remove_value name="global.$JKEOC_B74PendingShip" /></do_if><debug_text text="'[JKEOC][B83E][SHIPPING_READY] mode=%1 registered=%2'.[global.$JKEOC_B76AssignmentMode, global.$JKEOC_B76EligibleShips.count]" filter="general" /><signal_cue_instantly cue="JKEOC_B76_ScanBuildStorage" /></actions></cue>
  <cue name="JKEOC_B76_Scheduler" instantiate="true" namespace="this" checktime="player.age + 5min" checkinterval="5min"><conditions><check_value value="global.$JKEOC_B76AssignmentMode?" /></conditions><actions><signal_cue_instantly cue="JKEOC_B76_ScanBuildStorage" /></actions></cue>
  <cue name="JKEOC_B76_Menu" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B76_Menu" /></conditions><actions>
    <add_player_choice_sub text="'INFO: MODE %1 | REGISTERED %2'.[global.$JKEOC_B76AssignmentMode, global.$JKEOC_B76EligibleShips.count]" position="top_left" section="JKEOC_B76_Menu" />
    <do_if value="global.$JKEOC_B74PendingShip? and global.$JKEOC_B74PendingShip.exists and global.$JKEOC_B74PendingShip.isclass.ship and not global.$JKEOC_B74PendingShip.isunit and not global.$JKEOC_B74PendingShip.isclass.ship_xs"><add_player_choice_sub text="'REVIEW RECOMMENDED SHIP ASSIGNMENT'" position="left" section="JKEOC_B74_AssignmentMenu" /></do_if>
    <do_elseif value="global.$JKEOC_B76BuildStorageShip? and global.$JKEOC_B76BuildStorageShip.exists"><add_player_choice_sub text="'REVIEW BUILD-STORAGE ASSIGNMENT'" position="left" section="JKEOC_B76_BuildStorageReview" /></do_elseif>
    <do_else><add_player_choice_sub text="'REGISTER SUITABLE UNASSIGNED SHIPS'" position="left" section="JKEOC_B76_Register" /></do_else>
    <add_player_choice_sub text="'MODE: APPROVAL REQUIRED'" position="bottom_left" section="JKEOC_B76_ModeApproval" /><add_player_choice_sub text="'MODE: AUTO-ASSIGN REGISTERED SHIPS'" position="top_right" section="JKEOC_B76_ModeAuto" /><add_player_choice_sub text="'MODE: DISABLED / INSTRUCTIONS ONLY'" position="right" section="JKEOC_B76_ModeDisabled" /><add_player_choice_sub text="'BACK'" position="bottom_right" section="JKEOC_B72_OperationsHub" />
  </actions></cue>
  <cue name="JKEOC_B76_AutoRecommended" instantiate="true" namespace="this" checktime="player.age + 30s" checkinterval="30s"><conditions><check_value value="global.$JKEOC_B76AssignmentMode? and global.$JKEOC_B76AssignmentMode == 'AUTO-ASSIGN REGISTERED' and global.$JKEOC_B74PendingShip? and global.$JKEOC_B74PendingShip.exists and global.$JKEOC_B76EligibleShips.indexof.{global.$JKEOC_B74PendingShip} and global.$JKEOC_B74PendingShip.isclass.ship and not global.$JKEOC_B74PendingShip.isunit and not global.$JKEOC_B74PendingShip.isclass.ship_xs and not global.$JKEOC_B74PendingShip.commander and not global.$JKEOC_B74PendingShip.subordinates.count" /></conditions><actions><debug_text text="'[JKEOC][B83E][AUTO_AUTHORIZED] ship=%1 source=REGISTERED_LIST'.[global.$JKEOC_B74PendingShip.name]" filter="general" /><signal_cue_instantly cue="md.JKEOC_Operational_Remediation.JKEOC_B74_Assign" /></actions></cue>
  <cue name="JKEOC_B76_Register" instantiate="true" namespace="this">
    <conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B76_Register" /></conditions>
    <actions>
      <signal_cue_instantly cue="JKEOC_B92_RegisterShipsCore" />
      <add_player_choice_sub text="'RETURN'" position="bottom_right" section="JKEOC_B76_Menu" />
    </actions>
  </cue>

  <cue name="JKEOC_B92_RegisterShipsCore" instantiate="true" namespace="this">
    <conditions><event_cue_signalled /></conditions>
    <actions>
      <find_ship name="$ships" multiple="true" recursive="true" space="player.galaxy" owner="faction.player" hascommander="false" unit="false" class="[class.ship_m, class.ship_l, class.ship_xl]" />
      <set_value name="$discovered" exact="$ships.count" />
      <set_value name="$added" exact="0" />
      <set_value name="$unsupported" exact="0" />
      <set_value name="$notship" exact="0" />
      <set_value name="$unit" exact="0" />
      <set_value name="$assigned" exact="0" />
      <set_value name="$fleetleader" exact="0" />
      <set_value name="$nonoperational" exact="0" />
      <set_value name="$wrongpurpose" exact="0" />
      <set_value name="$alreadyregistered" exact="0" />
      <do_for_each name="$ship" in="$ships">
        <set_value name="$known" exact="false" />
        <do_for_each name="$registeredship" in="global.$JKEOC_B76EligibleShips">
          <do_if value="$registeredship == $ship"><set_value name="$known" exact="true" /></do_if>
        </do_for_each>
        <set_value name="$cargo" exact="$ship.waretransport.indexof.{waretransport.container} or $ship.waretransport.indexof.{waretransport.solid} or $ship.waretransport.indexof.{waretransport.liquid} or $ship.waretransport.indexof.{waretransport.condensate}" />
        <set_value name="$logisticspurpose" exact="$ship.primarypurpose == purpose.trade or $ship.primarypurpose == purpose.mine" />
        <do_if value="not $known and $ship != player.ship and $ship.isclass.ship and $ship.isoperational and not $ship.isunit and not $ship.isclass.ship_xs and not $ship.commander and not $ship.subordinates.count and $logisticspurpose and $cargo">
          <append_to_list name="global.$JKEOC_B76EligibleShips" exact="$ship" />
          <set_value name="$added" exact="$added + 1" />
          <debug_text text="'[JKEOC][B83E][SHIP_REGISTERED] ship=%1 purpose=%2 commander=%3 subordinates=%4 container=%5 solid=%6 liquid=%7 condensate=%8'.[$ship.name, $ship.primarypurpose, $ship.commander, $ship.subordinates.count, $ship.waretransport.indexof.{waretransport.container}, $ship.waretransport.indexof.{waretransport.solid}, $ship.waretransport.indexof.{waretransport.liquid}, $ship.waretransport.indexof.{waretransport.condensate}]" filter="general" />
        </do_if>
        <do_elseif value="$known"><set_value name="$alreadyregistered" exact="$alreadyregistered + 1" /></do_elseif>
        <do_elseif value="not $ship.isclass.ship"><set_value name="$notship" exact="$notship + 1" /></do_elseif>
        <do_elseif value="$ship.isunit or $ship.isclass.ship_xs"><set_value name="$unit" exact="$unit + 1" /></do_elseif>
        <do_elseif value="$ship.commander"><set_value name="$assigned" exact="$assigned + 1" /></do_elseif>
        <do_elseif value="$ship.subordinates.count"><set_value name="$fleetleader" exact="$fleetleader + 1" /></do_elseif>
        <do_elseif value="not $ship.isoperational"><set_value name="$nonoperational" exact="$nonoperational + 1" /></do_elseif>
        <do_elseif value="not $logisticspurpose"><set_value name="$wrongpurpose" exact="$wrongpurpose + 1" /></do_elseif>
        <do_else><set_value name="$unsupported" exact="$unsupported + 1" /></do_else>
      </do_for_each>
      <set_value name="global.$JKEOC_B92RegistrationAdded" exact="$added" />
      <set_value name="global.$JKEOC_B92RegistrationDiscovered" exact="$discovered" />
      <set_value name="global.$JKEOC_B92RegistrationUnsupported" exact="$unsupported" />
      <debug_text text="'[JKEOC][B83E][REGISTRATION_SCAN] native_free_discovered=%1 added=%2 registered_total=%3 already=%4 fleetleaders=%5 nonoperational=%6'.[$discovered, $added, global.$JKEOC_B76EligibleShips.count, $alreadyregistered, $fleetleader, $nonoperational]" filter="general" />
      <debug_text text="'[JKEOC][B83E][REGISTRATION_REJECT] nonlogistics=%1 unsupported_cargo=%2'.[$wrongpurpose, $unsupported]" filter="general" />
      <show_notification text="'ACTION: %1 suitable unassigned ship(s) registered from %2 discovered player ships. %3 unsupported candidate(s) left untouched.'.[$added, $discovered, $unsupported]" timeout="12s" />
      <signal_cue_instantly cue="JKEOC_B78_MatchRegistered" />
    </actions>
  </cue>

  <cue name="JKEOC_B79_MatchScheduler" instantiate="true" namespace="this" checktime="player.age + 30s" checkinterval="30s"><conditions><check_value value="global.$JKEOC_B76EligibleShips? and global.$JKEOC_B76EligibleShips.count gt 0" /></conditions><actions><signal_cue_instantly cue="JKEOC_B78_MatchRegistered" /></actions></cue>
  <cue name="JKEOC_B78_MatchRegistered" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><actions><do_if value="global.$JKEOC_B76AssignmentMode != 'DISABLED' and (not global.$JKEOC_B74PendingShip? or not global.$JKEOC_B74PendingShip.exists)"><remove_value name="$matchship" /><remove_value name="$matchremediation" /><do_for_each name="$r" in="global.$JKEOC_B70Remediations"><do_if value="not $matchship? and ($r.$state == 'OPEN' or $r.$state == 'ESCALATED') and $r.$shipcapability != 'NONE' and ($r.$assignment == 'Trade for Commander' or $r.$assignment == 'Mine for Commander')"><do_for_each name="$ship" in="global.$JKEOC_B76EligibleShips"><set_value name="$compatible" exact="$ship.exists and $ship.owner == faction.player and $ship.isclass.ship and $ship.isoperational and not $ship.isunit and not $ship.isclass.ship_xs and not $ship.commander and not $ship.subordinates.count and (($r.$assignment == 'Trade for Commander' and $ship.primarypurpose == purpose.trade and $ship.waretransport.indexof.{waretransport.container}) or ($r.$assignment == 'Mine for Commander' and $ship.primarypurpose == purpose.mine and $r.$subjectkey? and $ship.waretransport.indexof.{$r.$subjectkey.waretransport}))" /><do_if value="not $matchship? and $compatible"><set_value name="$matchship" exact="$ship" /><set_value name="$matchremediation" exact="$r" /></do_if></do_for_each></do_if></do_for_each><do_if value="$matchship?"><set_value name="$matchremediation.$matchedship" exact="$matchship" /><set_value name="$matchremediation.$verification" exact="'Registered compatible ship matched; awaiting selected authorization mode'" /><set_value name="global.$JKEOC_B74PendingRemediation" exact="$matchremediation" /><set_value name="global.$JKEOC_B74PendingShip" exact="$matchship" /><debug_text text="'[JKEOC][B83E][REGISTERED_MATCH] ship=%1 station=%2 assignment=%3 waretransport=%4 mode=%5'.[$matchship.name, $matchremediation.$stationname, $matchremediation.$assignment, if $matchremediation.$subjectkey? then $matchremediation.$subjectkey.waretransport else 'UNAVAILABLE', global.$JKEOC_B76AssignmentMode]" filter="general" /><do_if value="global.$JKEOC_B76AssignmentMode == 'AUTO-ASSIGN REGISTERED'"><signal_cue_instantly cue="md.JKEOC_Operational_Remediation.JKEOC_B74_Assign" /></do_if><do_else><show_notification text="'ACTION REQUIRED: Registered %1 is compatible with %2. Review Ship Assignment Authorization.'.[$matchship.name, $matchremediation.$stationname]" timeout="14s" /></do_else></do_if></do_if></actions></cue>
  <cue name="JKEOC_B76_ModeApproval" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B76_ModeApproval" /></conditions><actions><set_value name="global.$JKEOC_B76AssignmentMode" exact="'APPROVAL REQUIRED'" /><show_notification text="'ACTION: Approval Required active. EOC must show each ship, station and role before assignment.'" timeout="10s" /><debug_text text="'[JKEOC][B76][MODE] APPROVAL_REQUIRED'" filter="general" /><add_player_choice_sub text="'RETURN'" position="bottom_right" section="JKEOC_B76_Menu" /></actions></cue>
  <cue name="JKEOC_B76_ModeDisabled" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B76_ModeDisabled" /></conditions><actions><set_value name="global.$JKEOC_B76AssignmentMode" exact="'DISABLED'" /><show_notification text="'ACTION: Ship assignment disabled. Recommendations continue; EOC will assign no ships.'" timeout="10s" /><debug_text text="'[JKEOC][B76][MODE] DISABLED'" filter="general" /><add_player_choice_sub text="'RETURN'" position="bottom_right" section="JKEOC_B76_Menu" /></actions></cue>
  <cue name="JKEOC_B76_ModeAuto" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B76_ModeAuto" /></conditions><actions><add_player_choice_sub text="'INFO: ONLY REGISTERED, UNASSIGNED, NON-DRONE SHIPS MAY BE USED'" position="top_left" section="JKEOC_B76_ModeAuto" /><add_player_choice_sub text="'INFO: EOC MAY ASSIGN TRADE, MINE OR TRADE FOR BUILD STORAGE'" position="left" section="JKEOC_B76_ModeAuto" /><add_player_choice_sub text="'AUTHORIZE AUTO-ASSIGNMENT'" position="right" section="JKEOC_B76_EnableAuto" /><add_player_choice_sub text="'BACK - NO CHANGE'" position="bottom_right" section="JKEOC_B76_Menu" /></actions></cue>
  <cue name="JKEOC_B76_EnableAuto" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B76_EnableAuto" /></conditions><actions><set_value name="global.$JKEOC_B76AssignmentMode" exact="'AUTO-ASSIGN REGISTERED'" /><show_notification text="'ACTION: EOC auto-assignment enabled for registered ships only.'" timeout="10s" /><debug_text text="'[JKEOC][B76][MODE] AUTO_REGISTERED authorization=PLAYER'" filter="general" /><signal_cue_instantly cue="JKEOC_B76_ScanBuildStorage" /><add_player_choice_sub text="'RETURN'" position="bottom_right" section="JKEOC_B76_Menu" /></actions></cue>
  <cue name="JKEOC_B76_ScanBuildStorage" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><actions><remove_value name="$need" /><do_if value="global.$JKEOC_StationDirectory?"><do_for_each name="$d" in="global.$JKEOC_StationDirectory"><set_value name="$s" exact="$d.$station" /><do_if value="not $need? and $s.exists and $s.owner == faction.player and $d.$constructioncount gt 0 and $s.buildstorage and $s.subordinates.{assignment.tradeforbuildstorage}.count == 0"><set_value name="$need" exact="$d" /></do_if></do_for_each></do_if><remove_value name="$candidate" /><do_if value="$need?"><set_value name="global.$JKEOC_B76BuildStorageNeed" exact="$need" /><debug_text text="'[JKEOC][B83E][BUILD_STORAGE_NEED] station=%1 construction=%2 assigned=0'.[$need.$stationname, $need.$constructioncount]" filter="general" /><do_for_each name="$ship" in="global.$JKEOC_B76EligibleShips"><do_if value="not $candidate? and $ship.exists and $ship.owner == faction.player and $ship != player.ship and $ship.isclass.ship and $ship.isoperational and $ship.primarypurpose == purpose.trade and not $ship.isunit and not $ship.isclass.ship_xs and not $ship.commander and not $ship.subordinates.count and $ship.waretransport.indexof.{waretransport.container}"><set_value name="$candidate" exact="$ship" /></do_if></do_for_each><do_if value="$candidate?"><set_value name="global.$JKEOC_B76BuildStorageShip" exact="$candidate" /><do_if value="global.$JKEOC_B76AssignmentMode == 'AUTO-ASSIGN REGISTERED'"><signal_cue_instantly cue="JKEOC_B76_AssignBuildStorage" /></do_if><do_elseif value="global.$JKEOC_B76AssignmentMode == 'APPROVAL REQUIRED'"><show_notification text="'ACTION REQUIRED: %1 needs build-storage logistics. %2 is available; approve from Shipping Control.'.[$need.$stationname, $candidate.name]" timeout="14s" /></do_elseif></do_if><do_else><show_notification text="'RECOMMENDATION: %1 has active construction and no build-storage trader. Register or acquire a container trader.'.[$need.$stationname]" timeout="14s" /></do_else></do_if><debug_text text="'[JKEOC][B83E][BUILD_STORAGE_SCAN] need=%1 candidate=%2 mode=%3'.[$need?, $candidate?, global.$JKEOC_B76AssignmentMode]" filter="general" /></actions></cue>
  <cue name="JKEOC_B76_AssignBuildStorage" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><actions><set_value name="$d" exact="global.$JKEOC_B76BuildStorageNeed" /><set_value name="$ship" exact="global.$JKEOC_B76BuildStorageShip" /><do_if value="$d? and $d.$station.exists and $ship.exists and not $ship.isunit and not $ship.isclass.ship_xs and not $ship.commander and not $ship.subordinates.count"><set_object_commander object="$ship" commander="$d.$station" assignment="assignment.tradeforbuildstorage" /><debug_text text="'[JKEOC][B83E][BUILD_STORAGE_ASSIGN] ship=%1 station=%2 authorization=%3'.[$ship.name, $d.$stationname, global.$JKEOC_B76AssignmentMode]" filter="general" /><signal_cue_instantly cue="JKEOC_B76_VerifyBuildStorage" /></do_if></actions></cue>
  <cue name="JKEOC_B76_VerifyBuildStorage" instantiate="true" namespace="this"><conditions><event_cue_signalled /></conditions><delay exact="3s" /><actions><set_value name="$d" exact="global.$JKEOC_B76BuildStorageNeed" /><set_value name="$ship" exact="global.$JKEOC_B76BuildStorageShip" /><set_value name="$ok" exact="$ship.exists and $ship.commander == $d.$station and $ship.assignment == assignment.tradeforbuildstorage" /><do_if value="$ok"><show_notification text="'ACTION COMPLETE: %1 assigned to %2 for build-storage trade.'.[$ship.name, $d.$stationname]" timeout="12s" /><debug_text text="'[JKEOC][B76][BUILD_STORAGE_VERIFY] result=PASS ship=%1 station=%2'.[$ship.name, $d.$stationname]" filter="general" /><remove_from_list name="global.$JKEOC_B76EligibleShips" exact="$ship" /></do_if><do_else><show_notification text="'WARNING: Build-storage assignment could not be verified.'" timeout="12s" /><debug_text text="'[JKEOC][B76][BUILD_STORAGE_VERIFY] result=FAIL'" filter="general" /></do_else></actions></cue>
  <cue name="JKEOC_B76_BuildStorageReview" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B76_BuildStorageReview" /></conditions><actions><add_player_choice_sub text="'INFO: SHIP: %1 | ROLE: TRADE FOR BUILD STORAGE'.[global.$JKEOC_B76BuildStorageShip.name]" position="top_left" section="JKEOC_B76_BuildStorageReview" /><add_player_choice_sub text="'INFO: STATION: %1'.[global.$JKEOC_B76BuildStorageNeed.$stationname]" position="left" section="JKEOC_B76_BuildStorageReview" /><add_player_choice_sub text="'AUTHORIZE THIS ASSIGNMENT'" position="right" section="JKEOC_B76_ApproveBuildStorage" /><add_player_choice_sub text="'BACK - NO CHANGE'" position="bottom_right" section="JKEOC_B76_Menu" /></actions></cue>
  <cue name="JKEOC_B76_ApproveBuildStorage" instantiate="true" namespace="this"><conditions><event_conversation_next_section actor="player.computer" section="JKEOC_B76_ApproveBuildStorage" /></conditions><actions><signal_cue_instantly cue="JKEOC_B76_AssignBuildStorage" /><add_player_choice_sub text="'RETURN'" position="bottom_right" section="JKEOC_B76_Menu" /></actions></cue>
</cues></mdscript>

